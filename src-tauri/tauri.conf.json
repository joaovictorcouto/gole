{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gole",
  "version": "1.0.5",
  "identifier": "CoutoApps.Gole",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Gole",
        "width": 1280,
        "height": 800,
        "resizable": false,
        "maximizable": false,
        "decorations": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "sql": {
      "preloadConnections": [
        "sqlite:gole.db"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "languages": [
          "PortugueseBR"
        ]
      },
      "wix": {
        "language": "pt-BR"
      }
    }
  }
}
